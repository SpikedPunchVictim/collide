{
  "name": "collide",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "cargo run --quiet --package collide-core --example gen_schemas && pnpm --filter @collide/pack-sdk gen",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build:packs": "node scripts/build-packs.ts",
    "check": "cargo run --quiet --package collide-checks -- all",
    "check:names": "cargo run --quiet --package collide-checks -- names",
    "check:deps": "cargo run --quiet --package collide-checks -- deps",
    "check:stubs": "cargo run --quiet --package collide-checks -- stubs"
  },
  "packageManager": "pnpm@11.17.0"
}
