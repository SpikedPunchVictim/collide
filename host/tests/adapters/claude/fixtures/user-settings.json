{
  "env": {
    "ANTHROPIC_BASE_URL": "https://gateway.example.com:8443/v1/proxy?api_key=FIXTURE-KEY-0000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "150000",
    "EDITOR": "vi"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "fixture-session-start --secret FIXTURE-HOOK-SECRET" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "fixture-prompt-guard" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "fixture-rewrite" }] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Grep", "hooks": [{ "type": "command", "command": "fixture-summarise" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "fixture-notify" }] }
    ]
  }
}
