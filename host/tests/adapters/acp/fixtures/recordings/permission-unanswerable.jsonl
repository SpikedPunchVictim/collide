# Built for the tests: the handshake (cut to what the session reads), then a permission request that offers no
# one-time option (an always-allow and an always-reject only). The host can pick neither, so it answers `cancelled`;
# the agent then ends its turn. Shapes as in `permission-request`; ids and the tool call are stand-ins.
{"expect":{"method":"initialize","params":{"protocolVersion":1}},"as":"init"}
{"say":{"jsonrpc":"2.0","id":{"$id":"init"},"result":{"protocolVersion":1,"agentCapabilities":{},"authMethods":[]}}}
{"expect":{"method":"session/new"},"as":"new"}
{"say":{"jsonrpc":"2.0","id":{"$id":"new"},"result":{"sessionId":"ses-stand-in-1"}}}
{"expect":{"method":"session/prompt","params":{"sessionId":"ses-stand-in-1","prompt":[{"type":"text"}]}},"as":"prompt"}
{"say":{"jsonrpc":"2.0","id":7,"method":"session/request_permission","params":{"sessionId":"ses-stand-in-1","toolCall":{"toolCallId":"call-stand-in-1","title":"bash","kind":"execute","rawInput":{}},"options":[{"optionId":"always","name":"Allow always","kind":"allow_always"},{"optionId":"never","name":"Reject always","kind":"reject_always"}]}}}
{"expect":{"jsonrpc":"2.0","id":7,"result":{"outcome":{"outcome":"cancelled"}}}}
{"say":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"ses-stand-in-1","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"Not run."}}}}}
{"say":{"jsonrpc":"2.0","id":{"$id":"prompt"},"result":{"stopReason":"end_turn"}}}
