# Built for the tests: the handshake (cut to what the session reads), a permission request that no one answers, then
# the agent ends its turn with the request still open. The host answers it `cancelled` when it reads the response,
# so the agent never waits on it; the last expectation checks that answer. Ids and the tool call are stand-ins.
{"expect":{"method":"initialize","params":{"protocolVersion":1}},"as":"init"}
{"say":{"jsonrpc":"2.0","id":{"$id":"init"},"result":{"protocolVersion":1,"agentCapabilities":{},"authMethods":[]}}}
{"expect":{"method":"session/new"},"as":"new"}
{"say":{"jsonrpc":"2.0","id":{"$id":"new"},"result":{"sessionId":"ses-stand-in-1"}}}
{"expect":{"method":"session/prompt","params":{"sessionId":"ses-stand-in-1","prompt":[{"type":"text"}]}},"as":"prompt"}
{"say":{"jsonrpc":"2.0","id":7,"method":"session/request_permission","params":{"sessionId":"ses-stand-in-1","toolCall":{"toolCallId":"call-stand-in-1","title":"bash","kind":"execute","rawInput":{}},"options":[{"optionId":"once","name":"Allow once","kind":"allow_once"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
{"say":{"jsonrpc":"2.0","id":{"$id":"prompt"},"result":{"stopReason":"end_turn"}}}
{"expect":{"jsonrpc":"2.0","id":7,"result":{"outcome":{"outcome":"cancelled"}}}}
