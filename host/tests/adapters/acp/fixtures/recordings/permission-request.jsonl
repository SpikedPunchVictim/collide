# Built for the tests: the handshake, then a permission request that the turn waits on, answered with the one-time
# allow. Follows `RequestPermissionRequest` and `RequestPermissionResponse` (schema-v1.31.0) as S7 measured them: the
# agent's own request id (here 7), a `toolCall` with `rawInput: {}` for a Bash call (O5), the three options an agent
# offered, and the request before the `tool_call` it names (O6). Ids and the tool call are stand-ins.
{"expect":{"method":"initialize","params":{"protocolVersion":1}},"as":"init"}
{"say":{"jsonrpc":"2.0","id":{"$id":"init"},"result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true,"mcpCapabilities":{"http":true,"sse":false},"promptCapabilities":{"image":false,"audio":false,"embeddedContext":true}},"agentInfo":{"name":"fake-acp-agent","version":"0"},"authMethods":[]}}}
{"expect":{"method":"session/new"},"as":"new"}
{"say":{"jsonrpc":"2.0","id":{"$id":"new"},"result":{"sessionId":"ses-stand-in-1"}}}
{"expect":{"method":"session/prompt","params":{"sessionId":"ses-stand-in-1","prompt":[{"type":"text"}]}},"as":"prompt"}
{"say":{"jsonrpc":"2.0","id":7,"method":"session/request_permission","params":{"sessionId":"ses-stand-in-1","toolCall":{"toolCallId":"call-stand-in-1","title":"bash","kind":"execute","rawInput":{}},"options":[{"optionId":"once","name":"Allow once","kind":"allow_once"},{"optionId":"always","name":"Allow always","kind":"allow_always"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
{"expect":{"jsonrpc":"2.0","id":7,"result":{"outcome":{"outcome":"selected","optionId":"once"}}}}
{"say":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"ses-stand-in-1","update":{"sessionUpdate":"tool_call","toolCallId":"call-stand-in-1","title":"bash","kind":"execute","status":"pending"}}}}
{"say":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"ses-stand-in-1","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"Done."}}}}}
{"say":{"jsonrpc":"2.0","id":{"$id":"prompt"},"result":{"stopReason":"end_turn"}}}
