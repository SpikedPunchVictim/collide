# Built for the tests: an agent that offers only the draft `models` (S7, O9) and is asked for a model whose id has a
# `/` and a `:`, as `ollama/qwen2.5:7b` does. The client must write `session/set_model` with that id as given, answer
# it with an empty result, and only then write the prompt. Ids, names and models are stand-ins.
{"expect":{"method":"initialize","params":{"protocolVersion":1}},"as":"init"}
{"say":{"jsonrpc":"2.0","id":{"$id":"init"},"result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"agentInfo":{"name":"fake-acp-agent","version":"0"},"authMethods":[]}}}
{"expect":{"method":"session/new"},"as":"new"}
{"say":{"jsonrpc":"2.0","id":{"$id":"new"},"result":{"sessionId":"ses-stand-in-1","models":{"currentModelId":"stand-in/model:a","availableModels":[{"modelId":"stand-in/model:a","name":"Stand-in A"},{"modelId":"stand-in/model:b","name":"Stand-in B"}]}}}}
{"expect":{"method":"session/set_model","params":{"sessionId":"ses-stand-in-1","modelId":"stand-in/model:b"}},"as":"set"}
{"say":{"jsonrpc":"2.0","id":{"$id":"set"},"result":{}}}
{"expect":{"method":"session/prompt","params":{"sessionId":"ses-stand-in-1","prompt":[{"type":"text"}]}},"as":"prompt"}
{"say":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"ses-stand-in-1","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"Done."}}}}}
{"say":{"jsonrpc":"2.0","id":{"$id":"prompt"},"result":{"stopReason":"end_turn"}}}
