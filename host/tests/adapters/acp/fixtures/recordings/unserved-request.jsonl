# Built for the tests: the handshake (cut to what the session reads), then a request of the agent that the client does
# not serve (`fs/read_text_file`: the client advertises no `fs`), which the host answers "method not found" (-32601)
# at once. The agent waits for that answer before it goes on and ends its turn. The id and the path are stand-ins.
{"expect":{"method":"initialize","params":{"protocolVersion":1}},"as":"init"}
{"say":{"jsonrpc":"2.0","id":{"$id":"init"},"result":{"protocolVersion":1,"agentCapabilities":{},"authMethods":[]}}}
{"expect":{"method":"session/new"},"as":"new"}
{"say":{"jsonrpc":"2.0","id":{"$id":"new"},"result":{"sessionId":"ses-stand-in-1"}}}
{"expect":{"method":"session/prompt","params":{"sessionId":"ses-stand-in-1","prompt":[{"type":"text"}]}},"as":"prompt"}
{"say":{"jsonrpc":"2.0","id":9,"method":"fs/read_text_file","params":{"sessionId":"ses-stand-in-1","path":"/work/notes.txt"}}}
{"expect":{"jsonrpc":"2.0","id":9,"error":{"code":-32601}}}
{"say":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"ses-stand-in-1","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"Read it myself."}}}}}
{"say":{"jsonrpc":"2.0","id":{"$id":"prompt"},"result":{"stopReason":"end_turn"}}}
