# Built for the tests: the handshake (cut to what the session reads), then a permission request with a string id
# (JSON-RPC allows either) that the host cancels. The item's order is each pending request answered `cancelled`
# first and `session/cancel` after, which the two expectations pin. The agent then ends its turn with `end_turn`,
# as opencode does after a cancel (S7, O1). Ids and the tool call are stand-ins.
{"expect":{"method":"initialize","params":{"protocolVersion":1}},"as":"init"}
{"say":{"jsonrpc":"2.0","id":{"$id":"init"},"result":{"protocolVersion":1,"agentCapabilities":{},"authMethods":[]}}}
{"expect":{"method":"session/new"},"as":"new"}
{"say":{"jsonrpc":"2.0","id":{"$id":"new"},"result":{"sessionId":"ses-stand-in-1"}}}
{"expect":{"method":"session/prompt","params":{"sessionId":"ses-stand-in-1","prompt":[{"type":"text"}]}},"as":"prompt"}
{"say":{"jsonrpc":"2.0","id":"perm-stand-in-1","method":"session/request_permission","params":{"sessionId":"ses-stand-in-1","toolCall":{"toolCallId":"call-stand-in-1","title":"bash","kind":"execute","rawInput":{}},"options":[{"optionId":"once","name":"Allow once","kind":"allow_once"},{"optionId":"always","name":"Allow always","kind":"allow_always"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
{"expect":{"jsonrpc":"2.0","id":"perm-stand-in-1","result":{"outcome":{"outcome":"cancelled"}}}}
{"expect":{"jsonrpc":"2.0","method":"session/cancel","params":{"sessionId":"ses-stand-in-1"}}}
{"say":{"jsonrpc":"2.0","id":{"$id":"prompt"},"result":{"stopReason":"end_turn"}}}
