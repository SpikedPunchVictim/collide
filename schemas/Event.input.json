{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Who made the write (0.5). `run` and `phase` are reserved now so that writes a run makes need no later schema\nchange. They are not tied to a kind: a workflow op inside a run may carry `run`, and an agent outside a run,\nsuch as one whose actor is read from the process tree, may have neither.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "person",
        "workflow",
        "agent"
      ],
      "type": "string"
    },
    "Batch": {
      "additionalProperties": false,
      "description": "One call on several items fires per item; `index` counts from 0.",
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "index",
        "size"
      ],
      "type": "object"
    },
    "BudgetScope": {
      "description": "The budget that stopped a run: the run's total, a phase's, or a role's (0.7, Budgets).",
      "enum": [
        "run",
        "phase",
        "role"
      ],
      "type": "string"
    },
    "Category": {
      "description": "The category every source status maps to, so views and columns work across sources (0.10).",
      "enum": [
        "backlog",
        "ready",
        "active",
        "review",
        "done",
        "dropped"
      ],
      "type": "string"
    },
    "Change": {
      "additionalProperties": false,
      "description": "The `change` a task point carries. `op` is null for a write made by a run (`via: run`). `from` is null at\ncreate and `to` is null at delete. `diff` is predicted at `before_*` and actual at `after_*`. `effectOf` is the\nkey of the item whose op changed this one.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "args": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Batch"
            },
            {
              "type": "null"
            }
          ]
        },
        "categoryMoved": {
          "type": "boolean"
        },
        "checkout": {
          "type": [
            "string",
            "null"
          ]
        },
        "diff": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldDiff"
          },
          "default": {},
          "type": "object"
        },
        "effectOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "type": "array"
        },
        "files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemState"
            },
            {
              "type": "null"
            }
          ]
        },
        "op": {
          "type": [
            "string",
            "null"
          ]
        },
        "renamed": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Rename"
          },
          "type": "array"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemState"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "$ref": "#/$defs/Via"
        }
      },
      "required": [
        "categoryMoved",
        "via",
        "actor"
      ],
      "type": "object"
    },
    "ChangeCause": {
      "description": "What made a `task.changed` notification.",
      "enum": [
        "head",
        "worktree",
        "remote",
        "journal",
        "startup"
      ],
      "type": "string"
    },
    "Effect": {
      "additionalProperties": false,
      "description": "One item that an op changed: an entry of `apply`'s and `preview`'s `items[]`.",
      "properties": {
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemState"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemState"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "type": "object"
    },
    "EventBody": {
      "description": "What happened. Each variant is one event name, and `event` is the tag. Unknown keys are refused.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`from` is null for the first state.",
          "properties": {
            "event": {
              "const": "run.transition",
              "type": "string"
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunState"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run": {
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/RunState"
            }
          },
          "required": [
            "event",
            "run",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The phase's log and transcript paths are carried, because a registry needs them (0.4). A `human` phase has no\nlog, only agent phases have a transcript, and a phase entering its first state has neither yet, so both are\nnull until they exist. `round` counts the phase's repeats, as `HookPhase.round` does.",
          "properties": {
            "event": {
              "const": "phase.transition",
              "type": "string"
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PhaseState"
                },
                {
                  "type": "null"
                }
              ]
            },
            "log": {
              "type": [
                "string",
                "null"
              ]
            },
            "phase": {
              "type": "string"
            },
            "round": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "run": {
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/PhaseState"
            },
            "transcript": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "event",
            "run",
            "phase",
            "round",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`run` is null for a gate on a named point that no run is running. A gate sits on a phase (`phase`) or on a\nnamed point (`point`, 0.4 Gates). `message` is the hook's own message, as in `HookResult.message`.",
          "properties": {
            "event": {
              "const": "gate.verdict",
              "type": "string"
            },
            "gate": {
              "type": "string"
            },
            "message": {
              "default": "",
              "type": "string"
            },
            "pack": {
              "type": "string"
            },
            "phase": {
              "type": [
                "string",
                "null"
              ]
            },
            "point": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Point"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/HookStatus"
            }
          },
          "required": [
            "event",
            "pack",
            "gate",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "permission.requested",
              "type": "string"
            },
            "phase": {
              "type": "string"
            },
            "request": {
              "type": "string"
            },
            "run": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "run",
            "phase",
            "request",
            "tool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "answer": {
              "$ref": "#/$defs/PermissionAnswer"
            },
            "event": {
              "const": "permission.answered",
              "type": "string"
            },
            "phase": {
              "type": "string"
            },
            "request": {
              "type": "string"
            },
            "run": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "run",
            "phase",
            "request",
            "answer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`cause` names the decision token, the budget, or the agent's stop-and-report that led to the question.\n`queue_item` is the Queue item the run waits on (0.13), so an answer matches its question.",
          "properties": {
            "cause": {
              "type": "string"
            },
            "event": {
              "const": "ask_human.asked",
              "type": "string"
            },
            "queue_item": {
              "type": "string"
            },
            "run": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "run",
            "cause",
            "queue_item"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "answer": {
              "type": "string"
            },
            "event": {
              "const": "ask_human.answered",
              "type": "string"
            },
            "queue_item": {
              "type": "string"
            },
            "run": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "run",
            "answer",
            "queue_item"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "budget.exceeded",
              "type": "string"
            },
            "run": {
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/BudgetScope"
            }
          },
          "required": [
            "event",
            "run",
            "scope"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "task.changed",
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "task": {
              "$ref": "#/$defs/TaskChanged"
            }
          },
          "required": [
            "event",
            "source",
            "task"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "task.renamed",
              "type": "string"
            },
            "rename": {
              "$ref": "#/$defs/Rename"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "source",
            "rename"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "task.removed",
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "task": {
              "$ref": "#/$defs/TaskRemoved"
            }
          },
          "required": [
            "event",
            "source",
            "task"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "task.invalid",
              "type": "string"
            },
            "invalid": {
              "$ref": "#/$defs/TaskInvalid"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "source",
            "invalid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A write Collide made. `key` names the item; the change says what it did.",
          "properties": {
            "change": {
              "$ref": "#/$defs/Change"
            },
            "event": {
              "const": "task.written",
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "source",
            "key",
            "change"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "workspace.transition",
              "type": "string"
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WorkspaceState"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "$ref": "#/$defs/WorkspaceState"
            },
            "workspace": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "workspace",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "metric.reported",
              "type": "string"
            },
            "line": {
              "$ref": "#/$defs/ReportLine"
            },
            "run": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "run",
            "line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "experiment.transition",
              "type": "string"
            },
            "from": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "id",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Written before the step. `action` says what the step will do. After a restart, an intent with no outcome is\nchecked against the world, never repeated blind (0.2).",
          "properties": {
            "action": {
              "type": "string"
            },
            "event": {
              "const": "step.intent",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/StepKind"
            },
            "step": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "step",
            "kind",
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Written after the step, with the same `step` and `kind`. `result` says how it ended; `detail` says more, such as\nthe merge commit or the PR url.",
          "properties": {
            "detail": {
              "default": "",
              "type": "string"
            },
            "event": {
              "const": "step.outcome",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/StepKind"
            },
            "result": {
              "$ref": "#/$defs/StepResult"
            },
            "step": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "step",
            "kind",
            "result"
          ],
          "type": "object"
        }
      ]
    },
    "FailCause": {
      "description": "Why a phase failed when the cause is known. A phase that ends with no `result` on a full volume fails with cause\n`disk`, not `lost` (0.2).",
      "enum": [
        "disk"
      ],
      "type": "string"
    },
    "FieldDiff": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "from": true,
            "to": true
          },
          "required": [
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "added": {
              "items": true,
              "type": "array"
            },
            "removed": {
              "items": true,
              "type": "array"
            }
          },
          "required": [
            "added",
            "removed"
          ],
          "type": "object"
        }
      ],
      "description": "One changed field: `{from, to}`, or `{added, removed}` for a set. `from` is null at create and `to` is null\nat delete."
    },
    "HookExperiment": {
      "additionalProperties": false,
      "description": "Inside an experiment: the experiment, the arm and the arm's directory, so a hook can skip a push (0.14).",
      "properties": {
        "arm": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "arm",
        "dir"
      ],
      "type": "object"
    },
    "HookStatus": {
      "description": "The verdict a hook writes. It is `ok`, `fail`, `unverified` (could not check here), `pending` (has not happened\nyet), `refused` or `error`. `unverified` and `pending` are valid only from some hooks: see [`effective_result`].",
      "enum": [
        "ok",
        "fail",
        "unverified",
        "pending",
        "refused",
        "error"
      ],
      "type": "string"
    },
    "ItemState": {
      "additionalProperties": false,
      "description": "An item's status and its category.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "category"
      ],
      "type": "object"
    },
    "PauseCause": {
      "description": "Why a run or a phase is paused (0.2, 0.3, 0.8). `ask_human` waits in the Queue, `usage_limit` waits for the\naccount's reset time, and `disk` is the free-space floor: nothing is started until space comes back (0.2).",
      "enum": [
        "ask_human",
        "usage_limit",
        "disk"
      ],
      "type": "string"
    },
    "PermissionAnswer": {
      "description": "The answer to a permission request (0.3, S7).",
      "enum": [
        "allow",
        "deny",
        "cancel"
      ],
      "type": "string"
    },
    "PhaseState": {
      "description": "Where a phase is (0.8, Phase). A shim that dies without an `exit.json` makes its phase `lost`, whatever the agent's\nstream said (0.2).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "running",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cause": {
              "$ref": "#/$defs/PauseCause"
            },
            "state": {
              "const": "paused",
              "type": "string"
            }
          },
          "required": [
            "state",
            "cause"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "ended",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cause": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FailCause"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "state": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "stopped",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "lost",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Point": {
      "description": "The point catalogue (0.4, Named points), in the table's order. Serialized as its dotted name. Adding a point is\na schema change: `Point.input.json` lists the names.",
      "enum": [
        "run.before_start",
        "run.after_end",
        "run.before_integrate",
        "run.after_integrate",
        "workspace.after_create",
        "workspace.before_remove",
        "phase.before_start",
        "phase.after_end",
        "task.before_status",
        "task.after_status",
        "task.before_op",
        "task.after_op",
        "task.before_move",
        "task.after_move",
        "experiment.before_arm",
        "experiment.after_arm"
      ],
      "type": "string"
    },
    "RemovedCause": {
      "description": "Why a task is gone.",
      "enum": [
        "deleted",
        "transferred",
        "unknown"
      ],
      "type": "string"
    },
    "Rename": {
      "additionalProperties": false,
      "description": "An id that changed, at Share or `renumber`. It is also the body of the provider's `task.renamed`\nnotification, which names the `checkout`; inside a `change`, the change's own `checkout` applies.",
      "properties": {
        "checkout": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "ReportLine": {
      "description": "One report line. Every line carries `v` and its timestamp `t`, because a time stamped at reading would be wrong\nby the tailing lag. Each variant repeats `v` and `t`: serde cannot flatten them out of a tagged enum that denies\nunknown keys. A key a reporter does not know is left out, and shows as \"not reported\" (0.13).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "attrs": {
              "additionalProperties": true,
              "type": [
                "object",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "span.start",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "parent": {
              "type": [
                "string",
                "null"
              ]
            },
            "t": {
              "type": "string"
            },
            "v": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
