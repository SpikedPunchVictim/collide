{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "One entry `A<n>` of an Assumptions part (0.10). A missing or invalid `state` reads `unverified`.",
      "properties": {
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "spike": {
          "type": [
            "string",
            "null"
          ]
        },
        "spikeStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "state",
        "evidence",
        "line"
      ],
      "type": "object"
    },
    "Category": {
      "description": "The category every source status maps to, so views and columns work across sources (0.10).",
      "enum": [
        "backlog",
        "ready",
        "active",
        "review",
        "done",
        "dropped"
      ],
      "type": "string"
    },
    "Checklist": {
      "additionalProperties": false,
      "description": "The checklist field type: the state of one template's items, pinned as `name@n`.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ChecklistItem"
          },
          "type": "array"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "template",
        "items"
      ],
      "type": "object"
    },
    "ChecklistItem": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ChecklistState"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "type": "object"
    },
    "ChecklistState": {
      "description": "The state of one checklist item. Only a person marks `done` or `n/a`; the gate is a pack's (ts-0012).",
      "enum": [
        "open",
        "suggested",
        "done",
        "n/a"
      ],
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One claim of a spike's record, read from a fenced `claim` block (0.10, \"A `spike`\"). `label` is `measured`,\n`inferred` or `unmeasured`. `verifiable` is the block's `yes` or `no`, and is left out when the block has none. Only\na block with no problem is a claim; the prose is never compared.",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "loadBearing": {
          "type": "boolean"
        },
        "verifiable": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "loadBearing"
      ],
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "What a proposal's features and tasks cover, derived and never written (0.10, \"A proposal's quality parts\").\n`featuresWithoutTask` are the `F<n>` that no task implements. `tasksWithoutFeature` are the ids of the tasks the\nproposal includes, not dropped, that implement no feature.",
      "properties": {
        "featuresWithoutTask": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tasksWithoutFeature": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "featuresWithoutTask",
        "tasksWithoutFeature"
      ],
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "One entry `D<n>` of a proposal's Decision log (0.10). The labels' values are text as written; `confidence` is\n`low`, `medium` or `high`. `line` is the entry's first line in the item's file.",
      "properties": {
        "confidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "passedOn": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revisitIf": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "passedOn",
        "evidence",
        "line"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One entry of an `Evidence:` label. `status` is the status of the item it names, when the scan has it. `proposal`\nis the proposal of a feature.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "proposal": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "kind"
      ],
      "type": "object"
    },
    "EvidenceKind": {
      "description": "What an `Evidence:` entry names: an item, a feature of a proposal as `pr-0003-km#F2`, or a path in the repo.",
      "enum": [
        "item",
        "feature",
        "path"
      ],
      "type": "string"
    },
    "Feature": {
      "additionalProperties": false,
      "description": "One feature of a proposal, read from the `## Features` part of its body (0.8, 0.10, \"A proposal's features\").\n`id` is `F<n>`, `section` is empty for an entry that is unsorted, and `summary` joins an entry's continuation lines.",
      "properties": {
        "id": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "section",
        "summary"
      ],
      "type": "object"
    },
    "FeatureProblem": {
      "additionalProperties": false,
      "description": "A line of the Features part that did not parse, with why (0.8, 0.10). `line` counts from 1 in the item's file.",
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "line",
        "reason"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One entry `R<n>` of a Findings part (0.10). `open`: neither `accepted` nor `dismissed`.",
      "properties": {
        "accepted": {
          "type": [
            "string",
            "null"
          ]
        },
        "dismissed": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "open": {
          "type": "boolean"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "title",
        "text",
        "open",
        "line"
      ],
      "type": "object"
    },
    "HookLink": {
      "additionalProperties": false,
      "description": "A link of a `tasks[]` entry, one hop out, in either direction and resolved across sources (0.5). `stale` says\nthat the source holding the other end is stale, so `kind`, `status` and `category` are the last it reported.\n`missing` says that the corpus holds no task with the key: `kind` and `status` are then empty and `category` is\n`backlog`, so a gate can refuse a link that goes nowhere. `feature` is set for a link whose type targets a feature\nof a proposal (`F2`, from `pr-0003-km#F2`): `key`, `kind`, `status` and `category` are then the proposal's, and\n`missing` says that the proposal is not held or has no such feature. It is left out for a link to an item.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "dir": {
          "$ref": "#/$defs/LinkDir"
        },
        "feature": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "missing": {
          "default": false,
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "dir",
        "key",
        "kind",
        "status",
        "category",
        "stale",
        "missing"
      ],
      "type": "object"
    },
    "ItemState": {
      "additionalProperties": false,
      "description": "An item's status and its category.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "category"
      ],
      "type": "object"
    },
    "LatestRun": {
      "additionalProperties": false,
      "description": "An item's latest finished run, frozen and read-only. A hook outside a run reads it, for example to find a\nverify verdict.",
      "properties": {
        "id": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "state": {
          "additionalProperties": true,
          "type": "object"
        },
        "workflow": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workflow",
        "outcome",
        "state"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A typed link on an item (0.8).",
      "properties": {
        "blocking": {
          "description": "Absent means the link type's `blocking` applies.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "to": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "to"
      ],
      "type": "object"
    },
    "LinkDir": {
      "description": "Which end of a link the item that stores it holds: `out` for `blocked-by`, which points at the blocker.\nCollide derives the other direction (0.10).",
      "enum": [
        "out",
        "in"
      ],
      "type": "string"
    },
    "LinkTarget": {
      "description": "What a link type points at: an item, or a feature of a proposal (`pr-0003-km#F2`, revision 14).",
      "enum": [
        "item",
        "feature"
      ],
      "type": "string"
    },
    "LinkTypeDecl": {
      "additionalProperties": false,
      "description": "A link type a provider holds: its direction, whether it blocks, and what it targets. A declaration with no\n`target` targets an item, so every declaration written before revision 14 reads as it did. `inverse` is what the\nother end calls the link (\"blocks\" for `blocked-by`); a declaration with none reads as it did.",
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "dir": {
          "$ref": "#/$defs/LinkDir"
        },
        "inverse": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/LinkTarget"
        }
      },
      "required": [
        "name",
        "dir",
        "blocking"
      ],
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "Where one copy of a task is.",
      "properties": {
        "checkout": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "checkout",
        "path"
      ],
      "type": "object"
    },
    "OpDecl": {
      "additionalProperties": false,
      "description": "An op, as a provider declares it. Its effect is the category it moves the item to, if any, so that\n`task.before_status` can fire before the op runs (0.4). `args` is the JSON Schema of its arguments, which the UI\nrenders as a form (0.10), and `checkouts` names the checkouts it may target (empty: any).",
      "properties": {
        "args": true,
        "checkouts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "movesTo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "PartProblem": {
      "additionalProperties": false,
      "description": "A line of a proposal's quality part (the Decision log, the Assumptions or the Findings) that is not right, with why\n(0.8, 0.10). `part` is the part's name, as `Decision`. `line` counts from 1 in the item's file.",
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "part": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "part",
        "line",
        "reason"
      ],
      "type": "object"
    },
    "Preregistration": {
      "additionalProperties": false,
      "description": "A spike's Pre-registration part (0.10, \"A `spike`\"): the text of each of its four labels, as written, and left out\nwhen the label is missing. `amendments` counts the `### Amendment` sections below the original text. `hashMatches`\nis present only when the frontmatter has `preregistered`: whether it is the hash of the original text.",
      "properties": {
        "amendments": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "budget": {
          "type": [
            "string",
            "null"
          ]
        },
        "cheapestTest": {
          "type": [
            "string",
            "null"
          ]
        },
        "hashMatches": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hypothesis": {
          "type": [
            "string",
            "null"
          ]
        },
        "killCriterion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "amendments"
      ],
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "description": "One task as a provider reports it. `key` is `source:shortId`; `id` is the long form that `get` and `apply`\ntake. `checkout` and `path` are set by a ref-scoped source. `kind` may be left out when the provider has one.",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "assumptions": {
          "description": "A proposal's Assumptions part. Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "type": "array"
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "checklist": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checklist"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkout": {
          "type": [
            "string",
            "null"
          ]
        },
        "claims": {
          "description": "A spike's claims, read from the fenced `claim` blocks of its record (0.10). Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "type": "array"
        },
        "collections": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ],
          "description": "What a proposal's features and included tasks cover, derived (0.10). Left out when it has neither."
        },
        "decisions": {
          "description": "A proposal's Decision log (0.10). Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "type": "array"
        },
        "featureProblems": {
          "description": "The lines of that part that did not parse. Left out when there are none.",
          "items": {
            "$ref": "#/$defs/FeatureProblem"
          },
          "type": "array"
        },
        "features": {
          "description": "A proposal's features, read from its Features part (0.8). Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "type": "array"
        },
        "fields": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "findings": {
          "description": "A proposal's Findings part. Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Link"
          },
          "type": "array"
        },
        "owners": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "partProblems": {
          "description": "The lines of those parts that are not right. Left out when there are none. They never refuse a move.",
          "items": {
            "$ref": "#/$defs/PartProblem"
          },
          "type": "array"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "preregistration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preregistration"
            },
            {
              "type": "null"
            }
          ],
          "description": "A spike's Pre-registration part (0.10). Left out when its record has none."
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        },
        "templateFields": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "id",
        "aliases",
        "title",
        "state",
        "version",
        "links",
        "owners",
        "labels",
        "collections",
        "templateFields",
        "fields"
      ],
      "type": "object"
    },
    "TaskCollision": {
      "additionalProperties": false,
      "description": "`task.collision`: one short id at different paths in several checkouts. It is a collision, never a divergence.",
      "properties": {
        "locations": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        },
        "shortId": {
          "type": "string"
        }
      },
      "required": [
        "shortId",
        "locations"
      ],
      "type": "object"
    },
    "TaskCopy": {
      "additionalProperties": false,
      "description": "One copy of a task in one checkout, for the drawer's per-checkout state and divergence (0.11, Task drawer).",
      "properties": {
        "checkout": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "checkout",
        "state",
        "version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`task.get` result. `task` is absent when nothing matches, which is an answer and not an error (as the provider's\n`get`). When a short id matches several items (two tasks numbered 12) `task` is absent and `ambiguous` lists their\nkeys, so the caller asks for the suffix. `runs` are the ids of the task's runs, newest first. `links` are the task's\nlinks one hop out in both directions, as a hook reads them (0.5). `ops` are the ops its source declares for its\nkind: what `collide task <id> <op>` maps its words to. `link_types` are the link types its source declares, so a\nreader can name the other end of a link (`inverse`). All three are additive.",
  "properties": {
    "ambiguous": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "collisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskCollision"
      },
      "type": "array"
    },
    "copies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskCopy"
      },
      "type": "array"
    },
    "latest_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/LatestRun"
        },
        {
          "type": "null"
        }
      ]
    },
    "link_types": {
      "items": {
        "$ref": "#/$defs/LinkTypeDecl"
      },
      "type": "array"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HookLink"
      },
      "type": "array"
    },
    "ops": {
      "items": {
        "$ref": "#/$defs/OpDecl"
      },
      "type": "array"
    },
    "runs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "task": {
      "anyOf": [
        {
          "$ref": "#/$defs/Task"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ambiguous",
    "copies",
    "collisions",
    "runs",
    "links"
  ],
  "title": "TaskGetResult",
  "type": "object"
}
