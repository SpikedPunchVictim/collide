{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One entry `R<n>` of a Findings part (0.10). `open`: neither `accepted` nor `dismissed`.",
  "properties": {
    "accepted": {
      "type": [
        "string",
        "null"
      ]
    },
    "dismissed": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "line": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "open": {
      "type": "boolean"
    },
    "section": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "severity",
    "title",
    "text",
    "open",
    "line"
  ],
  "title": "Finding",
  "type": "object"
}
