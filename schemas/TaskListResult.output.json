{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "One entry `A<n>` of a proposal's Assumptions part (0.10). `spike` is the spike that would settle it.",
      "properties": {
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "spike": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "evidence",
        "line"
      ],
      "type": "object"
    },
    "Category": {
      "description": "The category every source status maps to, so views and columns work across sources (0.10).",
      "enum": [
        "backlog",
        "ready",
        "active",
        "review",
        "done",
        "dropped"
      ],
      "type": "string"
    },
    "Checklist": {
      "additionalProperties": false,
      "description": "The checklist field type: the state of one template's items, pinned as `name@n`.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ChecklistItem"
          },
          "type": "array"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "template",
        "items"
      ],
      "type": "object"
    },
    "ChecklistItem": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ChecklistState"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "type": "object"
    },
    "ChecklistState": {
      "description": "The state of one checklist item. Only a person marks `done` or `n/a`; the gate is a pack's (ts-0012).",
      "enum": [
        "open",
        "suggested",
        "done",
        "n/a"
      ],
      "type": "string"
    },
    "Collection": {
      "additionalProperties": false,
      "description": "A grouping the source holds itself, such as an epic or a milestone (0.10). Each task names the collections it\nbelongs to in `Task.collections`.",
      "properties": {
        "groups": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CollectionGroup"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "groups"
      ],
      "type": "object"
    },
    "CollectionGroup": {
      "additionalProperties": false,
      "description": "One ordered group of a collection, such as a slice of an epic: the keys of its tasks, in order.",
      "properties": {
        "name": {
          "type": "string"
        },
        "tasks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "tasks"
      ],
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "One entry `D<n>` of a proposal's Decision log (0.10). The labels' values are text as written; `confidence` is\n`low`, `medium` or `high`. `line` is the entry's first line in the item's file.",
      "properties": {
        "confidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "passedOn": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revisitIf": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "passedOn",
        "evidence",
        "line"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One entry of an `Evidence:` label. `status` is the status of the item it names, when the scan has it. `proposal`\nis the proposal of a feature.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "proposal": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "kind"
      ],
      "type": "object"
    },
    "EvidenceKind": {
      "description": "What an `Evidence:` entry names: an item, a feature of a proposal as `pr-0003-km#F2`, or a path in the repo.",
      "enum": [
        "item",
        "feature",
        "path"
      ],
      "type": "string"
    },
    "Feature": {
      "additionalProperties": false,
      "description": "One feature of a proposal, read from the `## Features` part of its body (0.8, 0.10, \"A proposal's features\").\n`id` is `F<n>`, `section` is empty for an entry that is unsorted, and `summary` joins an entry's continuation lines.",
      "properties": {
        "id": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "section",
        "summary"
      ],
      "type": "object"
    },
    "FeatureProblem": {
      "additionalProperties": false,
      "description": "A line of the Features part that did not parse, with why (0.8, 0.10). `line` counts from 1 in the item's file.",
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "line",
        "reason"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One entry `R<n>` of a proposal's Findings part (0.10). `section` is `Red-team` or `Pre-mortem`. A finding with\nneither `accepted` nor `dismissed` is open.",
      "properties": {
        "accepted": {
          "type": [
            "string",
            "null"
          ]
        },
        "dismissed": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "section": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "section",
        "severity",
        "title",
        "text",
        "line"
      ],
      "type": "object"
    },
    "ItemState": {
      "additionalProperties": false,
      "description": "An item's status and its category.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "category"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A typed link on an item (0.8).",
      "properties": {
        "blocking": {
          "description": "Absent means the link type's `blocking` applies.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "to": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "to"
      ],
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "Where one copy of a task is.",
      "properties": {
        "checkout": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "checkout",
        "path"
      ],
      "type": "object"
    },
    "PartProblem": {
      "additionalProperties": false,
      "description": "A line of a proposal's quality part (the Decision log, the Assumptions or the Findings) that is not right, with why\n(0.8, 0.10). `part` is the part's name, as `Decision`. `line` counts from 1 in the item's file.",
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "part": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "part",
        "line",
        "reason"
      ],
      "type": "object"
    },
    "StaleSource": {
      "additionalProperties": false,
      "description": "A source whose last answer may be out of date, and why (`source.stale`, or a provider that is gone).",
      "properties": {
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "reason"
      ],
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "description": "One task as a provider reports it. `key` is `source:shortId`; `id` is the long form that `get` and `apply`\ntake. `checkout` and `path` are set by a ref-scoped source. `kind` may be left out when the provider has one.",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "assumptions": {
          "description": "A proposal's Assumptions part. Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "type": "array"
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "checklist": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checklist"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkout": {
          "type": [
            "string",
            "null"
          ]
        },
        "collections": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decisions": {
          "description": "A proposal's Decision log (0.10). Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "type": "array"
        },
        "featureProblems": {
          "description": "The lines of that part that did not parse. Left out when there are none.",
          "items": {
            "$ref": "#/$defs/FeatureProblem"
          },
          "type": "array"
        },
        "features": {
          "description": "A proposal's features, read from its Features part (0.8). Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "type": "array"
        },
        "fields": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "findings": {
          "description": "A proposal's Findings part. Left out when there are none.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Link"
          },
          "type": "array"
        },
        "owners": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "partProblems": {
          "description": "The lines of those parts that are not right. Left out when there are none. They never refuse a move.",
          "items": {
            "$ref": "#/$defs/PartProblem"
          },
          "type": "array"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        },
        "templateFields": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "id",
        "aliases",
        "title",
        "state",
        "version",
        "links",
        "owners",
        "labels",
        "collections",
        "templateFields",
        "fields"
      ],
      "type": "object"
    },
    "TaskCollision": {
      "additionalProperties": false,
      "description": "`task.collision`: one short id at different paths in several checkouts. It is a collision, never a divergence.",
      "properties": {
        "locations": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        },
        "shortId": {
          "type": "string"
        }
      },
      "required": [
        "shortId",
        "locations"
      ],
      "type": "object"
    },
    "TaskInvalid": {
      "additionalProperties": false,
      "description": "`task.invalid`: something the source could not read as a task. Core turns it into a Queue item. `checkout` is\nnull for a source that is not ref-scoped.",
      "properties": {
        "checkout": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "checkout",
        "reason"
      ],
      "type": "object"
    },
    "ViewReport": {
      "additionalProperties": false,
      "description": "What a view reports for one evaluation (0.10, Views): why it has no members, and what went wrong on the way. A clean\nview has no `error`, no counts and no unmatched keys. `steps` and `cycle` are the closure's run order.",
      "properties": {
        "cycle": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "description": "Why the view has no members, when it was refused. Its other fields are then empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "errors": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "description": "The tasks whose `where` raised an error, by reason.",
          "type": "object"
        },
        "goal_unmatched": {
          "description": "The closure's goal when it matches no task: the closure is then empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "invalid_items": {
          "default": 0,
          "description": "The board's invalid items, which no view can match.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "members": {
          "description": "How many tasks are members.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "not_reached": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "over_task_budget": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pass_budget_exhausted": {
          "default": false,
          "type": "boolean"
        },
        "steps": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "unmatched_exclude": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unmatched_include": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "members",
        "errors",
        "over_task_budget",
        "pass_budget_exhausted",
        "not_reached",
        "unmatched_include",
        "unmatched_exclude",
        "invalid_items",
        "steps",
        "cycle"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`task.list` result. `invalid` holds each item that could not be read, counted on the view (0.10). The board-wide\nlists (`collections`, `invalid`, `divergent`, `collisions`, `stale_sources`) come with the first page only. They\nare additive: a reader that does not know them reads the rest.",
  "properties": {
    "collections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Collection"
      },
      "type": "array"
    },
    "collisions": {
      "default": [],
      "description": "The keys that are at different paths in different checkouts.",
      "items": {
        "$ref": "#/$defs/TaskCollision"
      },
      "type": "array"
    },
    "divergent": {
      "default": [],
      "description": "The keys on the board whose copy in a workspace differs from the copy at its root.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "invalid": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskInvalid"
      },
      "type": "array"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "refreshing": {
      "default": false,
      "description": "The first listing of a source is still running, so the tasks are what the last run cached, or fewer.",
      "type": "boolean"
    },
    "stale_sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StaleSource"
      },
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "type": "array"
    },
    "view": {
      "anyOf": [
        {
          "$ref": "#/$defs/ViewReport"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the view said of itself, for a request that named or gave one."
    }
  },
  "required": [
    "tasks",
    "collections",
    "invalid",
    "divergent",
    "collisions",
    "stale_sources",
    "refreshing"
  ],
  "title": "TaskListResult",
  "type": "object"
}
