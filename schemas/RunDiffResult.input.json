{
  "$defs": {
    "CollapsedFolder": {
      "additionalProperties": false,
      "description": "A folder the diff collapses (dependency stores and build output that `.gitignore` does not hide, 0.11): its file\ncount and size are shown instead of its files. Lock files are never collapsed.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "files",
        "bytes"
      ],
      "type": "object"
    },
    "DiffFile": {
      "additionalProperties": false,
      "description": "One changed file. The counts are absent for a binary file.",
      "properties": {
        "additions": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "deletions": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "old_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DiffStatus"
        }
      },
      "required": [
        "path",
        "status"
      ],
      "type": "object"
    },
    "DiffStatus": {
      "enum": [
        "added",
        "modified",
        "deleted",
        "renamed"
      ],
      "type": "string"
    },
    "FilePatch": {
      "additionalProperties": false,
      "description": "One file's patch as text. It is untrusted (0.9). `truncated` says the text was cut, and `bytes` is the patch's\nfull size.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "text",
        "bytes",
        "truncated"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`run.diff` result, from `base` to `head`. `files` is capped, and `more` counts the files left out (the stored\nlist is capped with the rest counted, 0.11).",
  "properties": {
    "base": {
      "type": "string"
    },
    "collapsed": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CollapsedFolder"
      },
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/DiffFile"
      },
      "type": "array"
    },
    "head": {
      "type": "string"
    },
    "more": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "patch": {
      "anyOf": [
        {
          "$ref": "#/$defs/FilePatch"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "base",
    "head",
    "files",
    "more"
  ],
  "title": "RunDiffResult",
  "type": "object"
}
