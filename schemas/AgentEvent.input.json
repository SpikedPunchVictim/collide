{
  "$defs": {
    "FinalReportSource": {
      "description": "Where a [`AgentEvent::FinalReport`] came from: Claude's `result` field, or, for ACP, the message chunks after the\nlast tool call.",
      "enum": [
        "result_field",
        "reconstructed"
      ],
      "type": "string"
    },
    "HookDecision": {
      "description": "What a hook's own output decided, read from the `decision` it printed (0.3, The stream protocol). Only this word is\nkept: the output itself may hold secrets. `block` is a `PostToolUse` hook's, which leaves the tool's result as it was.",
      "enum": [
        "allow",
        "deny",
        "ask",
        "block"
      ],
      "type": "string"
    },
    "HookFailure": {
      "description": "How a hook that was meant to guard a tool call failed without stopping it (0.13, the failed-open detector).",
      "oneOf": [
        {
          "const": "exit_error",
          "description": "The hook exited with a code that is neither 0 nor the deliberate block, 2 (S9: exit 1).",
          "type": "string"
        },
        {
          "const": "no_verdict",
          "description": "The hook timed out, so it gave no verdict.",
          "type": "string"
        }
      ]
    },
    "HookOutcome": {
      "description": "How a hook call ended, as the agent reports it (S9: `success`, `error` for an exit other than 0, `cancelled` for a\ntimeout).",
      "enum": [
        "success",
        "error",
        "cancelled"
      ],
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "description": "An amount in a currency. Claude reports USD.",
      "properties": {
        "amount": {
          "format": "double",
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "PermissionOption": {
      "additionalProperties": false,
      "description": "One of the agent's own options in a permission request.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PermissionOptionKind"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "PermissionOptionKind": {
      "description": "The kind of one of the agent's own options in a permission request. Collide picks only the `*_once` kinds: the\nagent owns the scope and storage of an \"always\" choice, so no adapter selects one (0.3, Permissions).",
      "enum": [
        "allow_once",
        "allow_always",
        "reject_once",
        "reject_always"
      ],
      "type": "string"
    },
    "PermissionRequest": {
      "additionalProperties": false,
      "description": "A request to run a tool (0.3, Permissions). `input` is `None` when the agent has not sent it yet (opencode sends\n`rawInput: {}` for a Bash call, so the command is unknown until the host answers; S7). Such a request shows in the\nQueue as \"input not available until approved\" and no pack rule that reads the input may auto-allow it.\n`reason` says why it was asked, when the agent says. `options` are the agent's own.",
      "properties": {
        "id": {
          "type": "string"
        },
        "input": true,
        "kind": {
          "$ref": "#/$defs/ToolKind"
        },
        "options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionOption"
          },
          "type": "array"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "tool_call_id",
        "kind"
      ],
      "type": "object"
    },
    "RefusalCause": {
      "description": "Who refused a tool call, or why it did not run (0.3, The stream protocol). The adapter reads it from the tool's own\nmetadata and never from the result's text. `unknown` is any other shape of refusal.",
      "oneOf": [
        {
          "enum": [
            "unknown"
          ],
          "type": "string"
        },
        {
          "const": "hook",
          "description": "A hook denied it.",
          "type": "string"
        },
        {
          "const": "host",
          "description": "Collide's own `deny` answer.",
          "type": "string"
        },
        {
          "const": "rule",
          "description": "A permission rule, or an automatic deny.",
          "type": "string"
        },
        {
          "const": "missing_tool",
          "description": "The session does not have the tool.",
          "type": "string"
        }
      ]
    },
    "ToolKind": {
      "description": "What a tool call does, as the agent classifies it. Adapters classify by `kind` and input, never by a call's title\n(S7, O12).",
      "enum": [
        "read",
        "edit",
        "delete",
        "move",
        "search",
        "execute",
        "think",
        "fetch",
        "other"
      ],
      "type": "string"
    },
    "TurnEndReason": {
      "description": "Why a turn ended (0.3, A turn ends with). `error` carries the HTTP status of an API failure when there is one\n(S1 measured a 429). `blocked` is a prompt a `UserPromptSubmit` hook refused: the turn never ran, and `reason` is\nthe hook's own, when it gave one (S9). The result that follows it is the hook's message, never the phase's report.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "end_turn",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "max_tokens",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "max_turns",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The role's budget ran out (Claude's `error_max_budget_usd`). The phase pauses rather than fails (0.3).",
          "properties": {
            "type": {
              "const": "budget",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "refusal",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "blocked",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Usage": {
      "additionalProperties": false,
      "description": "What an agent spent (0.3, Usage). Every number is an `Option`: a figure the agent did not report is `None`, never\n0, and is left out of the JSON. `cache_write_1h` and `cache_write_5m` split `cache_write` by tier, where the tool\nreports the tiers (capability `usage_report.cache_write_tiers`). `model_time_ms` is the time the model call or calls\ntook, when the agent reports it (0.13: a turn's is a difference of a running total).",
      "properties": {
        "cache_read": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cache_write": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cache_write_1h": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cache_write_5m": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "context_size": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "context_used": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "model_time_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "quality": {
          "$ref": "#/$defs/UsageQuality"
        },
        "scope": {
          "$ref": "#/$defs/UsageScope"
        },
        "thought": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "scope",
        "quality"
      ],
      "type": "object"
    },
    "UsageQuality": {
      "description": "How far the figures of a [`Usage`] event can be trusted. A total built from `partial` figures is shown as \"at\nleast\" and never summed with `exact` ones (0.13).",
      "enum": [
        "exact",
        "partial",
        "unreported"
      ],
      "type": "string"
    },
    "UsageScope": {
      "description": "What a [`Usage`] event counts: one turn, one model step, the session so far, a compaction call, or another model call\noutside the turn's own (0.3, Usage).",
      "oneOf": [
        {
          "enum": [
            "turn",
            "step",
            "running_total"
          ],
          "type": "string"
        },
        {
          "const": "compaction",
          "description": "The model call of a compaction. A turn's own usage leaves it out, so it is its own event, never added into a\n`Turn` (0.3, Usage; S9).",
          "type": "string"
        },
        {
          "const": "other_calls",
          "description": "A model call that is neither the turn's own nor a compaction: a helper-model call, read as what the agent\nreports for the turn beyond the turn's own usage. Never added into a `Turn` either.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One normalized event of an agent session (0.3, Normalized events).\n\nEvery known event is a closed object: an unknown key is an error. An event whose `type` this version does not\nknow (a tool's newer stream, an event of a later Collide) reads as [`AgentEvent::Other`] with that name in\n`raw_type` and the rest of the object in `raw`, because a log line must stay readable. `Other` is also what an\nadapter emits for a stream event it does not map. It is written back as `{\"type\":\"other\",\"raw_type\":...}`, so a\nread-write-read is stable. The schema lists the known events only.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "A message of the agent, or one chunk of it.",
      "properties": {
        "text": {
          "type": "string"
        },
        "type": {
          "const": "message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A tool call. `input` is `None` while the agent has not sent it.",
      "properties": {
        "id": {
          "type": "string"
        },
        "input": true,
        "kind": {
          "$ref": "#/$defs/ToolKind"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "tool_call",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/PermissionRequest"
        },
        "type": {
          "const": "permission_request",
          "type": "string"
        }
      },
      "required": [
        "type",
        "request"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The request had no option Collide may pick, so the session answered `cancel` (0.3, Permissions).",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "type": {
          "const": "permission_unanswerable",
          "type": "string"
        }
      },
      "required": [
        "type",
        "request_id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The session id is known: at once for Claude, on the `session/new` response for ACP.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "session_bound",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "usage",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "type",
        "usage"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "`empty` is true when the turn gave no message, no tool call and zero or unreported usage.",
      "properties": {
        "cancel_requested": {
          "type": "boolean"
        },
        "empty": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/TurnEndReason"
        },
        "type": {
          "const": "turn_end",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason",
        "cancel_requested",
        "empty"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/FinalReportSource"
        },
        "text": {
          "type": "string"
        },
        "type": {
          "const": "final_report",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text",
        "source"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The account's usage limit is reached (0.3, Usage and rate limits). `reset_at_ms` is the wall-clock time it\nresets, in milliseconds since the Unix epoch, and is absent when the tool does not say. Only an adapter with\n`limit_signal` reports it.",
      "properties": {
        "reset_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "type": {
          "const": "limited",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "One hook call: its name (`PreToolUse:Bash`), the event it hooked (`PreToolUse`), how it ended, its exit code and\nthe `decision` its output gave, when it gave one. The hook's `stdout` and `stderr` are untrusted text that may\nhold secrets, so the event has no place for them (0.3, The stream protocol).",
      "properties": {
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "event": {
          "type": "string"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/HookOutcome"
        },
        "type": {
          "const": "hook_call",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "event",
        "outcome"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A tool hook failed (`cause`) and the call it hooked, `tool_call_id`, ran anyway: a guard that did not guard\n(0.13). It is what a session can know about the detector; the finding, with its cost, is the metrics item's.",
      "properties": {
        "cause": {
          "$ref": "#/$defs/HookFailure"
        },
        "event": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "type": {
          "const": "hook_failed_open",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "event",
        "tool_call_id",
        "cause"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A tool call that did not run, by the id of the [`AgentEvent::ToolCall`], and who refused it.",
      "properties": {
        "cause": {
          "$ref": "#/$defs/RefusalCause"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "const": "tool_refused",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "cause"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The size in bytes of a tool call's result, by the id of the [`AgentEvent::ToolCall`] (0.13, the token and context\nmetrics). It is given for every result, a refused call's included. The result's content is untrusted and may be\nlarge, so the event holds the size and nothing else.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tool_call_id": {
          "type": "string"
        },
        "type": {
          "const": "tool_result_size",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tool_call_id",
        "bytes"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "An event this version has no type for. `raw_type` is its own type name.",
      "properties": {
        "raw": true,
        "raw_type": {
          "type": "string"
        },
        "type": {
          "const": "other",
          "type": "string"
        }
      },
      "required": [
        "type",
        "raw_type"
      ],
      "type": "object"
    }
  ],
  "title": "AgentEvent"
}
