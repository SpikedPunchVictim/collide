{
  "$defs": {
    "PauseCause": {
      "description": "Why a run or a phase is paused (0.2, 0.3, 0.8). `ask_human` waits in the Queue, `usage_limit` waits for the\naccount's reset time, and `disk` is the free-space floor: nothing is started until space comes back (0.2).",
      "enum": [
        "ask_human",
        "usage_limit",
        "disk"
      ],
      "type": "string"
    },
    "RunState": {
      "description": "Where a run is (0.8, Run). It ends `ended(<outcome>)`, `failed` or `stopped`; `outcome` is the `end` token the run\nreached (0.7, Outcomes and terminal states). `integrating` is a run whose `integrate` answered `pending`, so the\npull request is not merged yet (0.4).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "running",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cause": {
              "$ref": "#/$defs/PauseCause"
            },
            "state": {
              "const": "paused",
              "type": "string"
            }
          },
          "required": [
            "state",
            "cause"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "integrating",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "minLength": 1,
              "type": "string"
            },
            "state": {
              "const": "ended",
              "type": "string"
            }
          },
          "required": [
            "state",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "stopped",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Survivor": {
      "additionalProperties": false,
      "description": "A process still alive after the final rescan (0.5, Stopping). One its hook recorded is stopped by the cleanup\nhook; one it did not record is listed here.",
      "properties": {
        "command": {
          "type": "string"
        },
        "pid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pid",
        "command"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`run.stop` result: the run's state after the stop, how many processes the first scan signalled, and the\nsurvivors.",
  "properties": {
    "signalled": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "survivors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Survivor"
      },
      "type": "array"
    }
  },
  "required": [
    "state",
    "signalled",
    "survivors"
  ],
  "title": "RunStopResult",
  "type": "object"
}
