{
  "$defs": {
    "Category": {
      "description": "The category every source status maps to, so views and columns work across sources (0.10).",
      "enum": [
        "backlog",
        "ready",
        "active",
        "review",
        "done",
        "dropped"
      ],
      "type": "string"
    },
    "ChecklistTemplate": {
      "additionalProperties": false,
      "description": "A checklist template. `gates` is the category whose status write the pack's gate blocks. The template's name\nis its key in `checklists:`.",
      "properties": {
        "gates": {
          "$ref": "#/$defs/Category"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ChecklistTemplateItem"
          },
          "type": "array"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "gates",
        "items"
      ],
      "type": "object"
    },
    "ChecklistTemplateItem": {
      "additionalProperties": false,
      "description": "One line of a checklist template. `when:` is CEL over the item.",
      "properties": {
        "id": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "text",
        "required"
      ],
      "type": "object"
    },
    "DerivedPoint": {
      "additionalProperties": false,
      "description": "A derived point (0.4): a name in the pack's namespace over one core point, with what it matches and a `when:`.",
      "properties": {
        "match": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "on": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "on"
      ],
      "type": "object"
    },
    "ProviderEntry": {
      "additionalProperties": false,
      "description": "One entry of `providers:`: the script that starts the provider, relative to the pack directory.",
      "properties": {
        "script": {
          "type": "string"
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    },
    "Requires": {
      "additionalProperties": false,
      "description": "`requires:` in a manifest. Only `tools` is read so far; `sdk` and `agents` come with `ts-0012-ua`.",
      "properties": {
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolRequirement"
          },
          "type": "array"
        }
      },
      "required": [
        "tools"
      ],
      "type": "object"
    },
    "ToolRequirement": {
      "additionalProperties": false,
      "description": "A tool the pack needs on `PATH` (0.7, `requires.tools`). `version` is a range such as `\">=22.18\"`; it is\noptional, as in `- { name: pnpm }`. Checking it is Stage 4.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "checklists": {
      "additionalProperties": {
        "$ref": "#/$defs/ChecklistTemplate"
      },
      "default": {},
      "type": "object"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "points": {
      "additionalProperties": {
        "$ref": "#/$defs/DerivedPoint"
      },
      "default": {},
      "type": "object"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderEntry"
      },
      "type": "object"
    },
    "requires": {
      "anyOf": [
        {
          "$ref": "#/$defs/Requires"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "points",
    "checklists"
  ],
  "title": "PackManifest",
  "type": "object"
}
