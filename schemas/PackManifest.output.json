        {
          "$ref": "#/$defs/Requires"
        },
        {
          "type": "null"
        }
      ]
    },
    "roles": {
      "additionalProperties": {
        "$ref": "#/$defs/Role"
      },
      "type": "object"
    },
    "syncs": {
      "additionalProperties": {
        "$ref": "#/$defs/HookEntry"
      },
      "description": "Named `sync` implementations (0.4). The plan names the kind and not the key: a decision for the owner.",
      "type": "object"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "views": {
      "additionalProperties": {
        "$ref": "#/$defs/View"
