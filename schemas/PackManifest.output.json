{
  "$defs": {
    "Accepts": {
      "additionalProperties": false,
      "description": "Which tasks a workflow can take (0.7, `accepts`): the sources, and the template fields it needs.",
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AgentPhase": {
      "additionalProperties": false,
      "description": "An `agent` phase: one role. With `fanout:` it is a `fanout` phase.",
      "properties": {
        "fanout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fanout"
            },
            {
              "type": "null"
            }
          ]
        },
        "gates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_cold": {
          "$ref": "#/$defs/OnCold",
          "default": "resume"
        },
        "outputs": {
          "description": "The files the phase writes to its directory.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "record": {
          "type": "boolean"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "sandbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sandbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "then": {
          "anyOf": [
            {
              "$ref": "#/$defs/Then"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "role",
        "prompt",
        "on_cold"
      ],
      "type": "object"
    },
    "ArtifactPrompt": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "artifact"
      ],
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "description": "One entry of `bindings:` (0.4): a handler attached to a named point. It names either a `gate` of this pack,\nwhich may bind only to a `before_*` point, or a `script`, a chain handler that may bind to any point.\n`match` narrows a core point (a status category, an op name or a target source); `when:` is CEL over `task`,\n`change` and this pack's `config`. `timeout` is the hook's own (0.5: default 30 s for task points, 120 s for\nmove points).\n\nThe plan describes bindings (0.4, Named points) and writes one as `task.before_status: review`; it does not\ngive the manifest key, so this shape is a decision for the owner. A list, because chain handlers run in the\norder written.",
      "properties": {
        "gate": {
          "type": [
            "string",
            "null"
          ]
        },
        "match": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "point": {
          "description": "A core point (`task.before_status`), a derived point of this pack (a key of `points:`), or another pack's\nderived point as `pack/point`.",
          "minLength": 1,
          "type": "string"
        },
        "script": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "point"
      ],
      "type": "object"
    },
    "Category": {
      "description": "The category every source status maps to, so views and columns work across sources (0.10).",
      "enum": [
        "backlog",
        "ready",
        "active",
        "review",
        "done",
        "dropped"
      ],
      "type": "string"
    },
    "ChecklistTemplate": {
      "additionalProperties": false,
      "description": "A checklist template. `gates` is the category whose status write the pack's gate blocks. The template's name\nis its key in `checklists:`.",
      "properties": {
        "gates": {
          "$ref": "#/$defs/Category"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ChecklistTemplateItem"
          },
          "type": "array"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "gates",
        "items"
      ],
      "type": "object"
    },
    "ChecklistTemplateItem": {
      "additionalProperties": false,
      "description": "One line of a checklist template. `when:` is CEL over the item.",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "text",
        "required"
      ],
      "type": "object"
    },
    "Closure": {
      "additionalProperties": false,
      "description": "`closure: { goal: plan:T-01-042, follow: depends_on }`: the open tasks the goal depends on, and the goal.",
      "properties": {
        "follow": {
          "$ref": "#/$defs/Follow"
        },
        "goal": {
          "type": "string"
        }
      },
      "required": [
        "goal",
        "follow"
      ],
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "A decision: a hook that returns one token per task, and the target each token goes to (0.7, `then:`).\n`tokens:` is optional; when it is there it declares the tokens the script may return, and `on:` must map\nexactly those. Without it, the keys of `on:` are the declared tokens.",
      "properties": {
        "on": {
          "additionalProperties": {
            "$ref": "#/$defs/Target"
          },
          "type": "object"
        },
        "script": {
          "minLength": 1,
          "type": "string"
        },
        "show": {
          "description": "What the person reads when a token reaches `ask_human` (0.7, `show:`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tokens": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "script",
        "on"
      ],
      "type": "object"
    },
    "DerivedPoint": {
      "additionalProperties": false,
      "description": "A derived point (0.4): a name in the pack's namespace over one core point, with what it matches and a `when:`.",
      "properties": {
        "match": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "on": {
          "minLength": 1,
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "on"
      ],
      "type": "object"
    },
    "Duration": {
      "description": "A whole number and a unit: 30s, 120m, 2h, 1d.",
      "pattern": "^[0-9]+(s|m|h|d)$",
      "type": "string"
    },
    "EndTarget": {
      "additionalProperties": false,
      "description": "`{ end: <outcome> }`: the run ends with this outcome (0.7, Outcomes and terminal states).",
      "properties": {
        "end": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "end"
      ],
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "description": "`experiment:` (0.7; used from Milestone D, 0.14): per-arm isolation for state that the clone shares. `env`,\n`appendOnly` and `unchanged` hold `{{ }}` templates over `arm.dir` and `git.commonDir` (0.5), so they are text\nhere and the experiment stage reads them.",
      "properties": {
        "appendOnly": {
          "description": "Paths that other work appends to during an experiment.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "branchPrefix": {
          "description": "The prefix of an arm's branches (default `collide-exp/`).",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "prepare": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "unchanged": {
          "description": "Paths that must be byte-identical at the end.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Fanout": {
      "additionalProperties": false,
      "description": "`fanout:` of an agent phase: one role on several `models`, or on several `instances`, never both. `when:` is\nCEL over the run (`round == 1`).",
      "properties": {
        "instances": {
          "items": {
            "$ref": "#/$defs/Instance"
          },
          "type": "array"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Follow": {
      "description": "`closure:` follows one kind of edge, from a goal task: the prototype board's run order.",
      "enum": [
        "depends_on"
      ],
      "type": "string"
    },
    "HookEntry": {
      "additionalProperties": false,
      "description": "A hook (0.5): the script that runs, how long it may run, how long it gets to stop, and a JSON Schema for each\noutput it may return. It is the entry of `gates:`, `integrations:`, `syncs:`, `metrics:` and a workspace\nimplementation's sub-hooks. `timeout` and `grace` use [`Duration`] (`120m`, `60s`).",
      "properties": {
        "grace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "description": "The time a stopped hook gets between SIGTERM and SIGKILL (0.5: default 60 s)."
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/SchemaObject"
          },
          "description": "A schema per output key. Outputs that fail it make the hook's result `error` (0.5).",
          "type": "object"
        },
        "script": {
          "minLength": 1,
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    },
    "HumanPhase": {
      "additionalProperties": false,
      "description": "A `human` phase: a Queue item where a person picks one of the tokens of `on:`. `human` is the text the item\nshows; `show` lists what the person should read (0.7, `show:`).",
      "properties": {
        "human": {
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "on": {
          "additionalProperties": {
            "$ref": "#/$defs/Target"
          },
          "type": "object"
        },
        "show": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "human",
        "on"
      ],
      "type": "object"
    },
    "Instance": {
      "additionalProperties": false,
      "description": "One instance of a fan-out (0.10, owner 2026-11-13): each names any of a model, an agent definition, a profile\nand a prompt. What an instance leaves out comes from the phase's role.",
      "properties": {
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Prompt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "groupBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "sort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sort"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "LayoutKind": {
      "description": "How the Field lays a view out.",
      "enum": [
        "board",
        "run-order"
      ],
      "type": "string"
    },
    "Metrics": {
      "additionalProperties": false,
      "description": "`metrics:` (0.7; used from Milestone C, 0.13): how a pack's own data becomes spans. `import` reads the pack's\ntiming lines; `processes` lists the processes a workspace started that sampling cannot attribute.",
      "properties": {
        "import": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "processes": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ObserverEntry": {
      "additionalProperties": false,
      "description": "An observer (0.4): a long-lived process that gets the events its `events:` patterns name, as JSONL on stdin\n(see [`crate::observer`]). A pattern is an event type (`run.transition`), a family (`run.*`) or `*`.",
      "properties": {
        "events": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "script": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "script",
        "events"
      ],
      "type": "object"
    },
    "OnCold": {
      "description": "`on_cold:` of an agent phase (0.3): what a phase does when its session's cache has expired.",
      "oneOf": [
        {
          "const": "resume",
          "description": "Keep the session.",
          "type": "string"
        },
        {
          "const": "fresh",
          "description": "Start a new session from a handoff note.",
          "type": "string"
        }
      ]
    },
    "Phase": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentPhase"
        },
        {
          "$ref": "#/$defs/ScriptPhase"
        },
        {
          "$ref": "#/$defs/WaitPhase"
        },
        {
          "$ref": "#/$defs/HumanPhase"
        }
      ]
    },
    "PhaseTable": {
      "additionalProperties": {
        "$ref": "#/$defs/Phase"
      },
      "description": "Phase names to phases, in declaration order.",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "Pack settings: pack name, then key, then value. A pack's schema checks each value.",
          "type": "object"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "launch": {
          "additionalProperties": true,
          "description": "Launch parameters (`maxRounds`, ...). The workflow declares which exist.",
          "type": "object"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Model alias to model name. The model source and account stay the user's.",
          "type": "object"
        },
        "packs": {
          "$ref": "#/$defs/ProfilePacks"
        },
        "roles": {
          "additionalProperties": {
            "$ref": "#/$defs/RoleOptions"
          },
          "description": "Context options by role, as `pack/role`.",
          "type": "object"
        },
        "workflow": {
          "description": "The default workflow under this profile, as `pack/workflow`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProfilePacks": {
      "additionalProperties": false,
      "description": "`packs: { on: [...], off: [...] }`: packs this profile switches on and off. A repo profile switches repo\npacks and a user profile user packs.",
      "properties": {
        "off": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Prompt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactPrompt"
        },
        {
          "type": "string"
        }
      ],
      "description": "A prompt: the name of one of the pack's prompts, or an earlier phase's artifact (`{ artifact: brief/x.md }`)."
    },
    "ProtectedAt": {
      "description": "When a violation of `protectedPaths` is acted on (0.9). Only `phase-end` exists: the phase fails at its end.",
      "enum": [
        "phase-end"
      ],
      "type": "string"
    },
    "ProtectedPaths": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/ProtectedPathsAt"
        }
      ],
      "description": "`protectedPaths:` (0.9): a list of repo globs, whose changes are flagged in review, or\n`{ paths: [...], at: phase-end }`, which also fails the phase at its end. It is read by what it holds (a list\nor a mapping), so that an unknown key in the mapping is refused by name, not as \"no variant matched\"."
    },
    "ProtectedPathsAt": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/ProtectedAt"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "paths",
        "at"
      ],
      "type": "object"
    },
    "ProviderEntry": {
      "additionalProperties": false,
      "description": "One entry of `providers:`: the script that starts the provider, relative to the pack directory.",
      "properties": {
        "script": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    },
    "Record": {
      "additionalProperties": false,
      "description": "`record:` (0.7): what the pack's `record` hook may commit at the line root. `paths` are globs over repo paths\nand an upper bound: only the files a write or a phase touched are committed.",
      "properties": {
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "script": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "paths",
        "script"
      ],
      "type": "object"
    },
    "RepoInstructions": {
      "description": "`repo_instructions: worktree | none`: whether the agent tool loads the repository's own instructions (`CLAUDE.md`,\nskills, commands) from the worktree (0.3, Context options; revision 21). Absent means `worktree`.",
      "enum": [
        "worktree",
        "none"
      ],
      "type": "string"
    },
    "Requires": {
      "additionalProperties": false,
      "description": "`requires:` in a manifest (0.7). Whether the running Collide, its SDK, the tools and the agents satisfy it is\nchecked when a board loads the pack (Stage 4).",
      "properties": {
        "agents": {
          "description": "The agents a pack is bound to (`[claude]`, 0.3).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "modelName": {
          "description": "A regular expression that a `model.name` must match (0.3), such as `\"^[a-z]+$\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "sdk": {
          "description": "The range of `@collide/pack-sdk` the pack accepts (0.6), such as `\">=0.1 <0.2\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolRequirement"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Role": {
      "additionalProperties": false,
      "description": "A role (0.3, 0.7): an agent, its definition, and the options that sit beside its model and budget.",
      "properties": {
        "agent": {
          "description": "The agent kind, one of `requires.agents` (`claude`).",
          "minLength": 1,
          "type": "string"
        },
        "allow_tools": {
          "description": "Tools the role asks for among the ones Collide disallows by default (0.3, Disallowed tools), as plain names.\nWhich names an adapter disallows is the adapter's.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "bash_output_max": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "compact_at": {
          "description": "Context options (0.3): the same four a profile may override.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "definition": {
          "description": "A path to the agent definition: in the pack, or `repo:` for one in the line's snapshot.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "mcp_output_max": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "model": {
          "description": "A model alias, resolved per user.",
          "type": [
            "string",
            "null"
          ]
        },
        "readOnly": {
          "type": "boolean"
        },
        "repo_instructions": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepoInstructions"
            },
            {
              "type": "null"
            }
          ],
          "description": "`worktree` (the default when absent) or `none`: whether the repository's own instructions load (0.3)."
        },
        "require": {
          "description": "The capabilities the role needs (0.3): each a name of [`crate::agent::CAPABILITY_NAMES`], or a name with a\nsub-flag (`permission_host.deny_message`). A tool that lacks one is refused at launch.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "RoleConfig": {
      "description": "`config: user | none`: which settings the agent tool reads (0.3, Context options).",
      "enum": [
        "user",
        "none"
      ],
      "type": "string"
    },
    "RoleOptions": {
      "additionalProperties": false,
      "description": "A role's context options (0.3), as a profile overrides them.",
      "properties": {
        "bash_output_max": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "compact_at": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "mcp_output_max": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "repo_instructions": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepoInstructions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RunBudget": {
      "additionalProperties": false,
      "description": "A budget in US dollars: a run's total (at the total, the run goes to `ask_human` with cause budget), or one\nrole's (0.7, `budget: { usd: 20 }`).",
      "properties": {
        "usd": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "usd"
      ],
      "type": "object"
    },
    "Sandbox": {
      "additionalProperties": false,
      "description": "The models whose phase instance gets a sandbox workspace (0.7).",
      "properties": {
        "models": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "models"
      ],
      "type": "object"
    },
    "SchemaObject": {
      "description": "A JSON Schema, its keywords not checked here. A setting may add the booleans `secret`, `overridable` and `repoOnly`.",
      "type": "object"
    },
    "ScriptPhase": {
      "additionalProperties": false,
      "description": "A `script` phase: a hook in the workspace. `agentWork: true` marks one that runs agents itself (0.3).",
      "properties": {
        "agentWork": {
          "type": "boolean"
        },
        "gates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "record": {
          "type": "boolean"
        },
        "script": {
          "minLength": 1,
          "type": "string"
        },
        "then": {
          "anyOf": [
            {
              "$ref": "#/$defs/Then"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    },
    "Sort": {
      "additionalProperties": false,
      "description": "`layout.sort` (0.11): a sort key and a direction. `by` is a field the surface can sort on (the Field's `id`,\n`title`, `epic`, `labels` and `status`; Tracks adds more), which the surface checks.",
      "properties": {
        "by": {
          "type": "string"
        },
        "dir": {
          "$ref": "#/$defs/SortDir"
        }
      },
      "required": [
        "by",
        "dir"
      ],
      "type": "object"
    },
    "SortDir": {
      "enum": [
        "asc",
        "desc"
      ],
      "type": "string"
    },
    "Target": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndTarget"
        },
        {
          "description": "A phase name, or [`ASK_HUMAN`].",
          "type": "string"
        }
      ],
      "description": "Where a transition goes: a phase name, `ask_human`, or `{ end: <outcome> }`."
    },
    "Then": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "$ref": "#/$defs/Target"
        }
      ],
      "description": "What follows a phase (0.7, `then:`). Without it, the next phase in declaration order follows, and the last\nphase ends the run with outcome `done`."
    },
    "ToolRequirement": {
      "additionalProperties": false,
      "description": "A tool the pack needs on `PATH` (0.7, `requires.tools`). `version` is a range such as `\">=22.18\"`; it is\noptional, as in `- { name: pnpm }`. `hint` is the pack's install advice, shown when the tool is missing (0.7: \"a\nmissing tool fails the load with the pack's install `hint:`\"). Checking the tool is Stage 4a.",
      "properties": {
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "View": {
      "additionalProperties": false,
      "properties": {
        "closure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Closure"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclude": {
          "description": "Task keys taken out of the view, after the other three are joined.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "description": "Task keys such as `plan:T-01-042`, hand-picked into the view.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Layout"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "profile": {
          "description": "The profile runs launched from this view get (0.7, Profiles).",
          "type": [
            "string",
            "null"
          ]
        },
        "queue": {
          "description": "Feeds a Queue lane (0.10, Planning sources).",
          "type": "boolean"
        },
        "where": {
          "description": "CEL over one task, as text (0.10). Its length is capped at [`MAX_CEL_SOURCE_BYTES`].",
          "type": [
            "string",
            "null"
          ]
        },
        "workflow": {
          "description": "The default workflow for runs launched from this view, as `pack/workflow`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "WaitPhase": {
      "additionalProperties": false,
      "description": "A `wait` phase: a hook polled every `interval` until it answers `ok` or `fail`, or `timeout` passes (0.7).\n`timeout` is required.",
      "properties": {
        "interval": {
          "$ref": "#/$defs/Duration",
          "default": "30s"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "then": {
          "anyOf": [
            {
              "$ref": "#/$defs/Then"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "$ref": "#/$defs/Duration"
        },
        "wait": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "wait",
        "interval",
        "timeout"
      ],
      "type": "object"
    },
    "Workflow": {
      "additionalProperties": false,
      "description": "One entry of `workflows:`.",
      "properties": {
        "accepts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Accepts"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrate": {
          "description": "A `pack/name` integrate implementation. A workflow without one cannot be accepted (0.4).",
          "type": [
            "string",
            "null"
          ]
        },
        "on_end": {
          "items": {
            "$ref": "#/$defs/WorkflowOp"
          },
          "type": "array"
        },
        "on_start": {
          "items": {
            "$ref": "#/$defs/WorkflowOp"
          },
          "type": "array"
        },
        "phases": {
          "$ref": "#/$defs/PhaseTable"
        },
        "start": {
          "description": "The first phase. The first one declared when this is missing.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "description": "A `pack/name` workspace implementation. Without it the built-in one is used (0.4).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "phases"
      ],
      "type": "object"
    },
    "WorkflowOp": {
      "additionalProperties": false,
      "description": "An op of `on_start` or `on_end` (0.4, Lifecycle order). It addresses status categories (`setStatus\n{ category: active }`). `when:` is CEL; in `on_end` it reads `outcome`.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "type": "object"
        },
        "op": {
          "minLength": 1,
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "WorkspaceImpl": {
      "additionalProperties": false,
      "description": "A workspace implementation (0.4): `demo/worktree`. Every hook returns `{ path, gitDir }` (0.1). `create` is\nthe one a workspace cannot be made without; `resume`, `remove`, `discard` and `cleanup` are the lifecycle's other\nsteps (0.4, Lifecycle order), and `sandbox`, `line` and `doctor` are the kinds and the check the reference pack\nhas (0.7, the example).",
      "properties": {
        "cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "create": {
          "$ref": "#/$defs/HookEntry"
        },
        "discard": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "doctor": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "remove": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "sandbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookEntry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "create"
      ],
      "type": "object"
    }
