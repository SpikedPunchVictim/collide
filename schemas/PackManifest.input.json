{
  "$defs": {
    "Accepts": {
      "additionalProperties": false,
      "description": "Which tasks a workflow can take (0.7, `accepts`): the sources, and the template fields it needs.",
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AgentPhase": {
      "additionalProperties": false,
      "description": "An `agent` phase: one role. With `fanout:` it is a `fanout` phase.",
      "properties": {
        "fanout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fanout"
            },
            {
              "type": "null"
            }
          ]
        },
        "gates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_cold": {
          "$ref": "#/$defs/OnCold",
          "default": "resume"
        },
        "outputs": {
          "description": "The files the phase writes to its directory.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "record": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        },
        "sandbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sandbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "then": {
          "anyOf": [
            {
              "$ref": "#/$defs/Then"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "role",
        "prompt"
      ],
      "type": "object"
    },
    "ArtifactPrompt": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string"
        }
      },
      "required": [
        "artifact"
      ],
      "type": "object"
    },
    "Category": {
      "description": "The category every source status maps to, so views and columns work across sources (0.10).",
      "enum": [
        "backlog",
        "ready",
        "active",
        "review",
        "done",
        "dropped"
      ],
      "type": "string"
    },
    "ChecklistTemplate": {
      "additionalProperties": false,
      "description": "A checklist template. `gates` is the category whose status write the pack's gate blocks. The template's name\nis its key in `checklists:`.",
      "properties": {
        "gates": {
          "$ref": "#/$defs/Category"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ChecklistTemplateItem"
          },
          "type": "array"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "gates",
        "items"
      ],
      "type": "object"
    },
    "ChecklistTemplateItem": {
      "additionalProperties": false,
      "description": "One line of a checklist template. `when:` is CEL over the item.",
      "properties": {
        "id": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    },
    "Closure": {
      "additionalProperties": false,
      "description": "`closure: { goal: plan:T-01-042, follow: depends_on }`: the open tasks the goal depends on, and the goal.",
      "properties": {
        "follow": {
          "$ref": "#/$defs/Follow"
        },
        "goal": {
          "type": "string"
        }
      },
      "required": [
        "goal",
        "follow"
      ],
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "A decision: a hook that returns one token per task, and the target each token goes to (0.7, `then:`).\n`tokens:` is optional; when it is there it declares the tokens the script may return, and `on:` must map\nexactly those. Without it, the keys of `on:` are the declared tokens.",
      "properties": {
        "on": {
          "additionalProperties": {
            "$ref": "#/$defs/Target"
          },
          "type": "object"
        },
        "script": {
          "type": "string"
        },
        "show": {
          "description": "What the person reads when a token reaches `ask_human` (0.7, `show:`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tokens": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "script",
        "on"
      ],
      "type": "object"
    },
    "DerivedPoint": {
      "additionalProperties": false,
      "description": "A derived point (0.4): a name in the pack's namespace over one core point, with what it matches and a `when:`.",
      "properties": {
        "match": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "on": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "on"
      ],
      "type": "object"
    },
    "Duration": {
      "description": "A whole number and a unit: 30s, 120m, 2h, 1d.",
      "pattern": "^[0-9]+(s|m|h|d)$",
      "type": "string"
    },
    "EndTarget": {
      "additionalProperties": false,
      "description": "`{ end: <outcome> }`: the run ends with this outcome (0.7, Outcomes and terminal states).",
      "properties": {
        "end": {
          "type": "string"
        }
      },
      "required": [
        "end"
      ],
      "type": "object"
    },
    "Fanout": {
      "additionalProperties": false,
      "description": "`fanout:` of an agent phase: one role on several `models`, or on several `instances`, never both. `when:` is\nCEL over the run (`round == 1`).",
      "properties": {
        "instances": {
          "items": {
            "$ref": "#/$defs/Instance"
          },
          "type": "array"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Follow": {
      "description": "`closure:` follows one kind of edge, from a goal task: the prototype board's run order.",
      "enum": [
        "depends_on"
      ],
      "type": "string"
    },
    "HumanPhase": {
      "additionalProperties": false,
      "description": "A `human` phase: a Queue item where a person picks one of the tokens of `on:`. `human` is the text the item\nshows; `show` lists what the person should read (0.7, `show:`).",
      "properties": {
        "human": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "on": {
          "additionalProperties": {
            "$ref": "#/$defs/Target"
          },
          "type": "object"
        },
        "show": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "human",
        "on"
      ],
      "type": "object"
    },
    "Instance": {
      "additionalProperties": false,
      "description": "One instance of a fan-out (0.10, owner 2026-11-13): each names any of a model, an agent definition, a profile\nand a prompt. What an instance leaves out comes from the phase's role.",
      "properties": {
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Prompt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "groupBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "sort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sort"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "LayoutKind": {
      "description": "How the Field lays a view out.",
      "enum": [
        "board",
        "run-order"
      ],
      "type": "string"
    },
    "OnCold": {
      "description": "`on_cold:` of an agent phase (0.3): what a phase does when its session's cache has expired.",
      "oneOf": [
        {
          "const": "resume",
          "description": "Keep the session.",
          "type": "string"
        },
        {
          "const": "fresh",
          "description": "Start a new session from a handoff note.",
          "type": "string"
        }
      ]
    },
    "Phase": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentPhase"
        },
        {
          "$ref": "#/$defs/ScriptPhase"
        },
        {
          "$ref": "#/$defs/WaitPhase"
        },
        {
          "$ref": "#/$defs/HumanPhase"
        }
      ]
    },
    "PhaseTable": {
      "additionalProperties": {
        "$ref": "#/$defs/Phase"
      },
      "description": "Phase names to phases, in declaration order.",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "Pack settings: pack name, then key, then value. A pack's schema checks each value.",
          "type": "object"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "launch": {
          "additionalProperties": true,
          "description": "Launch parameters (`maxRounds`, ...). The workflow declares which exist.",
          "type": "object"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Model alias to model name. The model source and account stay the user's.",
          "type": "object"
        },
        "packs": {
          "$ref": "#/$defs/ProfilePacks"
        },
        "roles": {
          "additionalProperties": {
            "$ref": "#/$defs/RoleOptions"
          },
          "description": "Context options by role, as `pack/role`.",
          "type": "object"
        },
        "workflow": {
          "description": "The default workflow under this profile, as `pack/workflow`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProfilePacks": {
      "additionalProperties": false,
      "description": "`packs: { on: [...], off: [...] }`: packs this profile switches on and off. A repo profile switches repo\npacks and a user profile user packs.",
      "properties": {
        "off": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Prompt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactPrompt"
        },
        {
          "type": "string"
        }
      ],
      "description": "A prompt: the name of one of the pack's prompts, or an earlier phase's artifact (`{ artifact: brief/x.md }`)."
    },
    "ProviderEntry": {
      "additionalProperties": false,
      "description": "One entry of `providers:`: the script that starts the provider, relative to the pack directory.",
      "properties": {
        "script": {
          "type": "string"
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    },
    "Requires": {
      "additionalProperties": false,
      "description": "`requires:` in a manifest. Only `tools` is read so far; `sdk` and `agents` come with `ts-0012-ua`.",
      "properties": {
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolRequirement"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RoleConfig": {
      "description": "`config: user | none`: which settings the agent tool reads (0.3, Context options).",
      "enum": [
        "user",
        "none"
      ],
      "type": "string"
    },
    "RoleOptions": {
      "additionalProperties": false,
      "description": "A role's context options (0.3), as a profile overrides them.",
      "properties": {
        "bash_output_max": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "compact_at": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "mcp_output_max": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Sandbox": {
      "additionalProperties": false,
      "description": "The models whose phase instance gets a sandbox workspace (0.7).",
      "properties": {
        "models": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "models"
      ],
      "type": "object"
    },
    "ScriptPhase": {
      "additionalProperties": false,
      "description": "A `script` phase: a hook in the workspace. `agentWork: true` marks one that runs agents itself (0.3).",
      "properties": {
        "agentWork": {
          "type": "boolean"
        },
        "gates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "record": {
          "type": "boolean"
        },
        "script": {
          "type": "string"
        },
        "then": {
          "anyOf": [
            {
              "$ref": "#/$defs/Then"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    },
    "Sort": {
      "additionalProperties": false,
      "description": "`layout.sort` (0.11): a sort key and a direction. `by` is a field the surface can sort on (the Field's `id`,\n`title`, `epic`, `labels` and `status`; Tracks adds more), which the surface checks.",
      "properties": {
        "by": {
          "type": "string"
        },
        "dir": {
          "$ref": "#/$defs/SortDir"
        }
      },
      "required": [
        "by",
        "dir"
      ],
      "type": "object"
    },
    "SortDir": {
      "enum": [
        "asc",
        "desc"
      ],
      "type": "string"
    },
    "Target": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndTarget"
        },
        {
          "description": "A phase name, or [`ASK_HUMAN`].",
          "type": "string"
        }
      ],
      "description": "Where a transition goes: a phase name, `ask_human`, or `{ end: <outcome> }`."
    },
    "Then": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "$ref": "#/$defs/Target"
        }
      ],
      "description": "What follows a phase (0.7, `then:`). Without it, the next phase in declaration order follows, and the last\nphase ends the run with outcome `done`."
    },
    "ToolRequirement": {
      "additionalProperties": false,
      "description": "A tool the pack needs on `PATH` (0.7, `requires.tools`). `version` is a range such as `\">=22.18\"`; it is\noptional, as in `- { name: pnpm }`. Checking it is Stage 4.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "View": {
      "additionalProperties": false,
      "properties": {
        "closure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Closure"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclude": {
          "description": "Task keys taken out of the view, after the other three are joined.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "description": "Task keys such as `plan:T-01-042`, hand-picked into the view.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Layout"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "profile": {
          "description": "The profile runs launched from this view get (0.7, Profiles).",
          "type": [
            "string",
            "null"
          ]
        },
        "queue": {
          "description": "Feeds a Queue lane (0.10, Planning sources).",
          "type": "boolean"
        },
        "where": {
          "description": "CEL over one task, as text (0.10). Its length is capped at [`MAX_CEL_SOURCE_BYTES`].",
          "type": [
            "string",
            "null"
          ]
        },
        "workflow": {
          "description": "The default workflow for runs launched from this view, as `pack/workflow`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "WaitPhase": {
      "additionalProperties": false,
      "description": "A `wait` phase: a hook polled every `interval` until it answers `ok` or `fail`, or `timeout` passes (0.7).\n`timeout` is required.",
      "properties": {
        "interval": {
          "$ref": "#/$defs/Duration",
          "default": "30s"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "then": {
          "anyOf": [
            {
              "$ref": "#/$defs/Then"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "$ref": "#/$defs/Duration"
        },
        "wait": {
          "type": "string"
        }
      },
      "required": [
        "wait",
        "timeout"
      ],
      "type": "object"
    },
    "Workflow": {
      "additionalProperties": false,
      "description": "One entry of `workflows:`.",
      "properties": {
        "accepts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Accepts"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrate": {
          "description": "A `pack/name` integrate implementation. A workflow without one cannot be accepted (0.4).",
          "type": [
            "string",
            "null"
          ]
        },
        "on_end": {
          "items": {
            "$ref": "#/$defs/WorkflowOp"
          },
          "type": "array"
        },
        "on_start": {
          "items": {
            "$ref": "#/$defs/WorkflowOp"
          },
          "type": "array"
        },
        "phases": {
          "$ref": "#/$defs/PhaseTable"
        },
        "start": {
          "description": "The first phase. The first one declared when this is missing.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "description": "A `pack/name` workspace implementation. Without it the built-in one is used (0.4).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "phases"
      ],
      "type": "object"
    },
    "WorkflowOp": {
      "additionalProperties": false,
      "description": "An op of `on_start` or `on_end` (0.4, Lifecycle order). It addresses status categories (`setStatus\n{ category: active }`). `when:` is CEL; in `on_end` it reads `outcome`.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "type": "object"
        },
        "op": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "checklists": {
      "additionalProperties": {
        "$ref": "#/$defs/ChecklistTemplate"
      },
      "default": {},
      "type": "object"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "points": {
      "additionalProperties": {
        "$ref": "#/$defs/DerivedPoint"
      },
      "default": {},
      "type": "object"
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/Profile"
      },
      "description": "Named profiles, which cover only this pack's own settings and workflows (0.7, Profiles).",
      "type": "object"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderEntry"
      },
      "type": "object"
    },
    "requires": {
      "anyOf": [
        {
          "$ref": "#/$defs/Requires"
        },
        {
          "type": "null"
        }
      ]
    },
    "views": {
      "additionalProperties": {
        "$ref": "#/$defs/View"
      },
      "description": "Named views a board may adopt by name (0.7, Keys added for planning).",
      "type": "object"
    },
    "workflows": {
      "additionalProperties": {
        "$ref": "#/$defs/Workflow"
      },
      "type": "object"
    }
  },
  "title": "PackManifest",
  "type": "object"
}
