{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collide",
  "version": "0.0.0",
  "identifier": "dev.collide.ide",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Collide" }],
    "security": {
      "csp": {
        "default-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'"],
        "img-src": ["'self'", "data:"],
        "font-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'none'"],
        "script-src": ["'self'", "'unsafe-inline'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:"],
        "font-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost", "http://127.0.0.1:*", "ws://127.0.0.1:*"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"]
      }
    }
  },
  "bundle": {
    "active": false,
    "resources": { "resources/builtin-packs/": "builtin-packs/" },
    "icon": ["icons/icon.png"]
  }
}
