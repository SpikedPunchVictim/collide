# Dependencies and build output
node_modules/
.pnpm-store/
target/
dist/

# Spike scratch: nested fixture repos, caches and raw run output.
# Each spike's own .gitignore lists these too.
.collide/planning/spikes/*/work/
.collide/planning/spikes/*/out/

# The planning provider's per-root write lock, its takeover claim and the temp file of a write that was killed
.collide/planning/.write-lock*
.collide/planning/**/*.collide-tmp

# Local settings and secrets
.env
.env.*
.claude/settings.local.json

# OS and editor
.DS_Store
*.swp
.idea/
.vscode/

# Private notes: unredacted originals, the name key and the denylist (never public)
private/

# Tauri build output
app/src-tauri/gen/
# The permission files `tauri-build` writes for the app's own commands (`app/src-tauri/build.rs`), at every build
app/src-tauri/permissions/autogenerated/

# Built-in packs staged for the bundle by `pnpm build:packs` (read-only; also its staging directory)
app/src-tauri/resources/
